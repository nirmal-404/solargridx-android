<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".ui.CreateReservationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_chevron_left"
                app:tint="#18181B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Energy Slot"
                    android:textColor="#09090B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prosumer Microgrid Energy Booking"
                    android:textColor="#71717A"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#18181B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="⚡ Prosumer"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E4E7" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E4E4E7"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reservation Details"
                            android:textColor="#09090B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Select a solar microgrid station and an eligible energy slot."
                            android:textColor="#71717A"
                            android:textSize="12sp" />

                        <!-- Field 1: Microgrid Station -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStation"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="Microgrid Station *"
                            app:startIconDrawable="@drawable/ic_sun"
                            app:startIconTint="#2563EB">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvStation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:dropDownHeight="200dp"
                                android:inputType="none"
                                android:paddingVertical="14dp"
                                android:textColor="#09090B"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Field 2: Reservation Date -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDate"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="Reservation Date *"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMode="custom"
                            app:endIconTint="#2563EB"
                            app:startIconDrawable="@drawable/ic_calendar"
                            app:startIconTint="#2563EB">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:inputType="none"
                                android:paddingVertical="14dp"
                                android:textColor="#09090B"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Field 3: Available Energy Slot -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSlot"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="Available Energy Slot *"
                            app:startIconDrawable="@drawable/ic_clock"
                            app:startIconTint="#EA580C">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvSlot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:dropDownHeight="200dp"
                                android:enabled="false"
                                android:inputType="none"
                                android:paddingVertical="14dp"
                                android:textColor="#09090B"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Field 4: Requested Capacity (kWh) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCapacity"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="Requested Capacity *"
                            app:suffixText="kWh"
                            app:suffixTextColor="#2563EB"
                            app:startIconDrawable="@drawable/ic_lightning"
                            app:startIconTint="#16A34A">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCapacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:paddingVertical="14dp"
                                android:text="10"
                                android:textColor="#09090B"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Slot Capacity / Info Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardSlotDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="#F0FDF4"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#BBF7D0"
                            app:strokeWidth="1dp"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvSlotDetailTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚡ Selected Slot Availability"
                                    android:textColor="#166534"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvSlotDetailSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Capacity: 25.0 kWh available"
                                    android:textColor="#15803D"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmReservation"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="20dp"
                            android:backgroundTint="#18181B"
                            android:text="Confirm Reservation"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Error Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardErrorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FEF2F2"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FECACA"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvErrorTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reservation Error"
                            android:textColor="#991B1B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvErrorMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#B91C1C"
                            android:textSize="13sp"
                            tools:text="The selected slot is no longer available or station capacity is exceeded." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetry"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="Retry / Refresh Slots"
                            android:textColor="#991B1B"
                            android:textSize="12sp"
                            app:strokeColor="#FCA5A5" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Success Confirmation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuccessResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#BBF7D0"
                    app:strokeWidth="2dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="#16A34A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="RESERVATION CREATED"
                                android:textColor="#166534"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSuccessReservationId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="#09090B"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Reservation ID: RES-2026-X801" />

                        <TextView
                            android:id="@+id/tvSuccessDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#3F3F46"
                            android:textSize="13sp"
                            tools:text="Station: SGX-01 (Colombo Node)\nScheduled: 2026-09-22 09:00 - 10:00\nRequested Capacity: 10.0 kWh\nStatus: Pending Operational Approval" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBookAnother"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="Book Another Slot"
                                android:textColor="#09090B"
                                android:textSize="13sp"
                                app:strokeColor="#E4E4E7" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReturnDashboard"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#18181B"
                                android:text="Done / Dashboard"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
